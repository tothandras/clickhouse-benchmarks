# devenv / direnv
.devenv/
.devenv.flake.nix
.devcontainer.json
.direnv/

# node tooling (deps installed from pnpm-lock.yaml on shell entry)
node_modules/

# Python venv for the mcp-clickhouse MCP server (managed by devenv + uv;
# rebuilt from pyproject.toml on shell entry). uv.lock IS committed for
# reproducible installs; the venv itself is not.
.venv/
__pycache__/
*.pyc

# devenv-managed kubeconfig
.kube/

# stray clickhouse-server data when started from the repo root with a
# relative <path> (defensive — .devenv/clickhouse-server/data/ is gitignored
# under .devenv/ already)
/data/

# Go
/bin/
*.test
*.out

# editor
.vscode/
.idea/
.DS_Store

# claude code runtime state
.claude/scheduled_tasks.lock
