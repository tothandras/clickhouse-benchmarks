#!/usr/bin/env bash

eval "$(devenv direnvrc)"

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence all output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
use devenv

# Load remote ClickHouse cluster credentials (gitignored). These populate the
# CLICKHOUSE_* / CLICKHOUSE_DSN vars consumed by the bench harness and the
# mcp-clickhouse MCP server (see .mcp.json). Optional — absent .env is fine.
dotenv_if_exists .env
